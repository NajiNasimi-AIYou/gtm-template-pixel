// Viant Pixel GTM Tag Template
// GTM required variables 
// Created by Naji Nasimi
// Viant Inc. (https://www.viant.com/)

const sendPixel = require('sendPixel');
const log = require('logToConsole');
const encodeUriComponent = require('encodeUriComponent');
const getTimestampMillis = require('getTimestampMillis');
const makeString = require('makeString');
const makeNumber = require('makeNumber');
const getUrl = require('getUrl');

function appendOptionalParam(pixelUrl, include, paramName, paramValue) {
  if (include && paramValue) {
    pixelUrl += '&' + paramName + '=' + encodeUriComponent(paramValue);
  }
  return pixelUrl;
}

const upid = makeNumber(data.pixelId);
const includeRevenue = !!data.checkbox2;
const includeCurrency = !!data.checkbox3;
const includeCustomerType = !!data.checkbox4;
const includeProductCategory = !!data.checkbox5;
const includeReferrerUrl = !!data.checkbox6;
const includeTransactionId = !!data.checkbox7;
const includeUserId = !!data.checkbox8;

for (var j = 1; j <= 10; j++) {
  var cbKey = 'checkbox' + (j + 8);
  var pk = 'p' + j;
  var inc = !!data[cbKey];
}

const configuredPageUrl = makeString('{{Page URL}}');
const referrerUrl = makeString(getUrl('referrer') || '');
let pageUrl = configuredPageUrl || referrerUrl;
let droppedUrlReason = '';

if (!pageUrl) {
  droppedUrlReason = 'empty';
} else if (pageUrl.indexOf('tagmanager.googleusercontent.com/js_sandbox_v2.html') !== -1) {
  droppedUrlReason = 'sandbox_url';
}

if (droppedUrlReason) {
  pageUrl = '';
}

const revenueValue = makeString(data.revenue || '');
const currencyValue = makeString(data.currency || '');
const customerTypeValue = makeString(
  data.customerType || data.customer_type || ''
);
const productCategoryValue = makeString(data.productCategory || '');
const transactionIdValue = makeString(data.transactionID || data.transactionId || '');
const userIdValue = makeString(data.userID || data.userId || '');
const configuredReferrerParam = makeString(
  data.referrerURL || data.referrerUrl || data.referrer_url || ''
);
let referrerParam = configuredReferrerParam || referrerUrl;
let droppedReferrerReason = '';

if (!referrerParam) {
  droppedReferrerReason = 'empty';
} else if (referrerParam.indexOf('tagmanager.googleusercontent.com/js_sandbox_v2.html') !== -1) {
  droppedReferrerReason = 'sandbox_url';
}

if (droppedReferrerReason) {
  referrerParam = '';
}

if (!upid) {
  data.gtmOnFailure();
  return;
}

const endpoint = 'https://ad.ipredictive.com/d/track/event';
const cacheBuster = makeString(getTimestampMillis());

let pixelUrl =
  endpoint +
  '?upid=' + encodeUriComponent(makeString(upid)) +
  '&cache_buster=' + encodeUriComponent(cacheBuster) +
  '&ps=2';

var optionalParams = [
  {
    include: true,
    name: 'url',
    value: pageUrl
  },
  {
    include: includeRevenue,
    name: 'revenue',
    value: revenueValue
  },
  {
    include: includeCurrency,
    name: 'currency',
    value: currencyValue
  },
  {
    include: includeCustomerType,
    name: 'customerType',
    value: customerTypeValue
  },
  {
    include: includeProductCategory,
    name: 'productCategory',
    value: productCategoryValue
  },
  {
    include: includeReferrerUrl,
    name: 'referrerURL',
    value: referrerParam
  },
  {
    include: includeTransactionId,
    name: 'transactionID',
    value: transactionIdValue
  },
  {
    include: includeUserId,
    name: 'userID',
    value: userIdValue
  }
];

for (var m = 0; m < optionalParams.length; m++) {
  var p = optionalParams[m];
  pixelUrl = appendOptionalParam(pixelUrl, p.include, p.name, p.value);
}

for (var n = 1; n <= 10; n++) {
  var cbName = 'checkbox' + (n + 8);
  var paramName = 'p' + n;
  var includeParam = !!data[cbName];
  var paramValue = makeString(data[paramName] || '');
  pixelUrl = appendOptionalParam(pixelUrl, includeParam, paramName, paramValue);
}

log('Final pixel URL:', pixelUrl);
sendPixel(pixelUrl, data.gtmOnSuccess, data.gtmOnFailure);


